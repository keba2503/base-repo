{
  "name": "base-repo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter web dev",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "arch": "bun scripts/architecture/check.ts",
    "structure": "bun scripts/architecture/structure.ts",
    "env-example": "bun scripts/architecture/env-example.ts",
    "depcruise": "depcruise --config .dependency-cruiser.mjs apps packages scripts",
    "test": "bun test --conditions react-server",
    "check": "bun run lint && bun run typecheck && bun run depcruise && bun run arch && bun run structure && bun run env-example && bun run test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9",
    "globals": "^17.12.0",
    "lefthook": "^2.1.12",
    "server-only": "^0.0.1",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "zod": "^4.5.4"
  }
}
